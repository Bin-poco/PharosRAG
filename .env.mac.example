# 复制为 .env.mac 后填写真实密钥；.env.mac 已被 .gitignore 忽略。

# 阿里云百炼 / DashScope：负责文本、图片向量和重排。
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
# 新版 qwen3-vl-rerank 可能要求“业务空间专属 URL”，请从百炼控制台/API 文档复制完整地址覆盖这里。
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
CLOUD_EMBEDDING_MODEL=qwen3-vl-embedding
CLOUD_RERANK_MODEL=qwen3-vl-rerank
CLOUD_DENSE_DIM=1024
CLOUD_TIMEOUT=120

# DeepSeek：负责检索后的答案生成。
DEEPSEEK_API_KEY=
PHAROS_LLM_BASE_URL=https://api.deepseek.com
PHAROS_LLM_MODEL=deepseek-v4-flash
PHAROS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# MinerU：用户上传 PDF 后执行结构化解析。到 https://mineru.net/apiManage 申请 Token。
# 默认沿用原项目 pharos parse 使用的 MINERU_TOKEN_A；真实值只放 .env.mac。
MINERU_TOKEN_A=
PHAROS_MINERU_TOKEN_ENV=MINERU_TOKEN_A
PHAROS_MINERU_BASE_URL=https://mineru.net
PHAROS_MINERU_MODEL_VERSION=vlm
PHAROS_MINERU_LANGUAGE=ch
PHAROS_MINERU_POLL_SECONDS=5
PHAROS_MINERU_TIMEOUT_SECONDS=1800

# 可靠上传任务：PostgreSQL 保存业务状态，Redis 只作为 Celery broker。
# 仅本地开发可使用示例密码；部署时必须替换。
PHAROS_POSTGRES_PASSWORD=pharos-dev-only
PHAROS_JOB_MAX_ATTEMPTS=3
PHAROS_JOB_HEARTBEAT_SECONDS=15
PHAROS_JOB_STALE_SECONDS=120
# dispatcher 预占后若进程崩溃，短暂 publishing 状态超过此时间即可补投。
PHAROS_JOB_PUBLISH_STALE_SECONDS=60
# 已发布但一直未被 Worker 领取的任务，超过此时间后允许 Outbox 补投。
PHAROS_JOB_DISPATCH_STALE_SECONDS=3600
PHAROS_JOB_VISIBILITY_TIMEOUT=3600
PHAROS_JOB_SOFT_TIME_LIMIT=2100
PHAROS_JOB_TIME_LIMIT=2400

# 本地知识库与检索配置。
PHAROS_TENANT=demo
PHAROS_COLLECTION=tech_docs
PHAROS_DENSE_DIM=1024
PHAROS_SMART_ASK=on
PHAROS_INFERENCE_TIMEOUT=120
PHAROS_INFERENCE_CONNECT_TIMEOUT=5
PHAROS_INFERENCE_RETRIES=2
PHAROS_INFERENCE_BACKOFF=0.5

# 仅用于 docs/MAC_DOCKER_DEV.md 中的本地 curl 示例；改它时也要同步修改 keys 文件。
PHAROS_DEV_API_KEY=local-dev-key-change-me-before-sharing

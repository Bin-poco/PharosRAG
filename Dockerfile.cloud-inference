FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir "fastapi>=0.110" "uvicorn>=0.29" "httpx>=0.27" \
    && useradd --create-home --uid 10001 appuser

COPY src/cloud_inference ./cloud_inference

USER appuser

EXPOSE 8900

CMD ["uvicorn", "cloud_inference.service:app", "--host", "0.0.0.0", "--port", "8900"]
